# Firebase web app config — public client identifiers, NOT secrets (they ship
# in the JS bundle regardless). Committed so every build — CI or local — is
# self-contained. Vite loads this file in every mode (apex/dashboard/admin);
# use .env.local (gitignored) to override values locally, e.g. for emulators.
VITE_FIREBASE_API_KEY=AIzaSyApb-EBpIdItXW0AxuYzs5JIHbvbHt622w
# Custom auth domain (D-002/#9): OAuth redirects land on auth.siapp.app so the
# flow stays on a first-party domain. Must be listed in Auth authorized domains.
VITE_FIREBASE_AUTH_DOMAIN=auth.siapp.app
VITE_FIREBASE_PROJECT_ID=siapp-prod
VITE_FIREBASE_STORAGE_BUCKET=siapp-prod.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1087770923189
VITE_FIREBASE_APP_ID=1:1087770923189:web:2dfbba3061e045fff82efc

# Set to "true" (in .env.local) to point the SDK at the local emulator suite.
VITE_USE_EMULATORS=false

# Early-access lead capture (impl-28): all "Request early access" CTAs on the
# marketing page link out to this Typeform. Lead capture is fully external —
# no backend, no Firestore collection. Swap the form here; components read it
# via import.meta.env.
VITE_EARLY_ACCESS_FORM_URL=https://form.typeform.com/to/GyoSjy9n

# Error tracking (#27, Part B): Sentry DSN — publishable client identifier,
# safe to commit (same posture as the Firebase config above). One shared DSN
# across all three surfaces; events are tagged with `surface` in initSentry.
# Absent/empty ⇒ reportError() stays a local console no-op and no Sentry code
# ships. See src/lib/reportError.ts and src/lib/initSentry.ts.
VITE_SENTRY_DSN=https://efdf5837cf8d4e03de0a4c65ef0ba53b@o4511742878023680.ingest.us.sentry.io/4511790971551744
