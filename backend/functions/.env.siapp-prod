# Deploy-time params for the siapp-prod project (firebase-functions params).
# Committed on purpose: non-interactive CI deploys cannot prompt for param
# values (even ones with code defaults). No secrets here — secrets live in
# Secret Manager via defineSecret.

# Dashboard origin used in emailed invite links (defineString in
# src/callables/invites.ts).
APP_ORIGIN=https://dashboard.siapp.app

# Apex origin used in client portal / collaborator links (defineString in
# src/callables/issuePortalLink.ts and issueCollabLink.ts).
PORTAL_ORIGIN=https://siapp.app

# Comma-separated exact IPs allowed to call admin functions
# (src/admin/adminGuard.ts fails closed when unset). Not a secret — it only
# narrows access on top of isAdmin claim + MFA. Update and redeploy if the
# admin's public IP changes.
ADMIN_IP_ALLOWLIST=66.114.42.194
