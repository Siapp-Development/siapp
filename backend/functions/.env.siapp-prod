# Deploy-time params for the siapp-prod project (firebase-functions params).
# Committed on purpose: non-interactive CI deploys cannot prompt for param
# values (even ones with code defaults). No secrets here — secrets live in
# Secret Manager via defineSecret.

# Dashboard origin used in emailed invite links (defineString in
# src/callables/invites.ts).
APP_ORIGIN=https://dashboard.siapp.app

# Apex origin used in client portal / collaborator links (defineString in
# src/callables/issuePortalLink.ts and issueCollabLink.ts).
PORTAL_ORIGIN=https://siapp.app

# Comma-separated exact IPs allowed to call admin functions
# (src/admin/adminGuard.ts fails closed when unset). Not a secret — it only
# narrows access on top of isAdmin claim + MFA. Update and redeploy if the
# admin's public IP changes.
ADMIN_IP_ALLOWLIST=66.114.42.194

# ── Outbound WhatsApp via Twilio (#133) ────────────────────────────────────
# Non-secret params only. The Twilio ACCOUNT SID + AUTH TOKEN are SECRETS and
# live in Secret Manager (defineSecret TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN)
# — never committed here.

# Shared Siapp WhatsApp sender (D-001), WITHOUT the `whatsapp:` prefix.
# defineString in src/lib/messaging/twilioConfig.ts.
WA_SENDER=+13604414161

# Approved Twilio Content Template SIDs (HX…) per outbound trigger. Not secrets
# (same pattern as PORTAL_ORIGIN). Blank = template not yet approved → that
# trigger's messages fail with errorCode 'no_content_sid' (O-7). Fill in each
# HX id after the template is approved in the Twilio Content Template Builder
# (see plans/whatsapp-templates-v1.md). defineString in
# src/lib/messaging/contentSids.ts.
WA_CONTENT_SID_PROJECT_WELCOME=HX7e1ed9a3bc978cfed1089797b44315c0
WA_CONTENT_SID_TASK_ASSIGNED=
WA_CONTENT_SID_TASK_STATUS_CHANGE=
WA_CONTENT_SID_TASK_DUE_SOON=HX7002fc2be96fb62aa025f87cffe48a6e
WA_CONTENT_SID_TASK_BLOCKED=
WA_CONTENT_SID_NEED_HELP=
WA_CONTENT_SID_WA_QUOTA_90=
WA_CONTENT_SID_COLLAB_ACCESS_LINK=HX63e9cd015c54842e567b7af4070d407b
