# Deploy-time params for the siapp-prod project (firebase-functions params).
# Committed on purpose: non-interactive CI deploys cannot prompt for param
# values (even ones with code defaults). No secrets here — secrets live in
# Secret Manager via defineSecret.

# Dashboard origin used in emailed invite links (defineString in
# src/callables/invites.ts).
APP_ORIGIN=https://dashboard.siapp.app
